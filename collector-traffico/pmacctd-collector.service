[Unit]
Description=Collector di traffico: conteggio dal mirror (pmacctd)
After=network.target
PartOf=collector-traffico.service

[Service]
EnvironmentFile=/etc/collector-traffico/collector.env
Environment=TZ=UTC
# La scheda in mirror non ha indirizzo e non trasmette: niente IPv6 (niente annunci), niente ARP.
ExecStartPre=/bin/sh -c 'test -n "${MIRROR_IF}"'
ExecStartPre=/sbin/sysctl -q -w net.ipv6.conf.${MIRROR_IF}.disable_ipv6=1
ExecStartPre=/sbin/ip link set dev ${MIRROR_IF} arp off promisc on up
ExecStart=/usr/sbin/pmacctd -f /etc/collector-traffico/pmacctd.conf -i ${MIRROR_IF}
Restart=on-failure
RestartSec=10
MemoryMax=256M

[Install]
WantedBy=multi-user.target
