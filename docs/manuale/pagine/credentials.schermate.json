[
  { "file": "tabella", "percorso": "/credentials",
    "ritaglio": ["text=Elenco credenziali", "button:has-text('Nuova credenziale')", "tbody tr:nth-child(4)"],
    "segni": [
      { "n": 1, "cerca": "button:has-text('Nuova credenziale')" },
      { "n": 2, "cerca": "th:has-text('Tipo')" },
      { "n": 3, "cerca": "th:has-text('Usata da')" },
      { "n": 4, "cerca": "tbody tr:nth-child(2) button:has-text('Test')" },
      { "n": 5, "cerca": "tbody tr:nth-child(2) button[title='Modifica']" },
      { "n": 6, "cerca": "tbody tr:nth-child(2) td:last-child button >> nth=-1" }
    ] },
  { "file": "nuova", "percorso": "/credentials",
    "prima": [{ "clic": "button:has-text('Nuova credenziale')", "attesa": 800 }],
    "zona": "[role=dialog]" },
  { "file": "dove-usata", "percorso": "/credentials",
    "prima": [{ "clic": "tbody button[title='Dove è usata'] >> nth=0", "attesa": 1500 }],
    "zona": "[role=dialog]" },
  { "file": "test", "percorso": "/credentials",
    "prima": [{ "clic": "tbody button:has-text('Test') >> nth=0", "attesa": 800 }],
    "zona": "[role=dialog]" }
]
